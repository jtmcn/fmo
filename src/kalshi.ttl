@prefix ksh:  <https://w3id.org/forecast-market-ontology/kalshi#> .
@prefix fm:   <https://w3id.org/forecast-market-ontology/core#> .
@prefix wx:   <https://w3id.org/forecast-market-ontology/weather#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

<https://w3id.org/forecast-market-ontology/kalshi>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/forecast-market-ontology/kalshi/0.20.0> ;
    owl:priorVersion <https://w3id.org/forecast-market-ontology/kalshi/0.19.0> ;
    owl:imports <https://w3id.org/forecast-market-ontology/core> , <https://w3id.org/forecast-market-ontology/weather> ;
    dcterms:title "FMO Kalshi: prediction market listings, trading, and settlement" ;
    dcterms:description """The market half of the ontology, covering Kalshi's series/event/market
hierarchy, binary contracts, orders and trades, and settlement against an authoritative
source. Weather markets are the motivating case, so this module also carries the axioms
that tie a market's proposition to a weather observation target.""" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.20.0" ;
    skos:scopeNote """Field names and enumerations mirror the Kalshi trading API. Enumerations were checked
against the live API and the published reference on 2026-08-17, field names against Trade
API 3.31.0 on 2026-09-25. The first check corrected the market status
enumeration, added the scalar resolution outcome, and reopened the typing of prices and
contract quantities; see the scope notes on those terms.""" .

################################################################
# The venue
################################################################

ksh:Exchange a owl:Class ;
    rdfs:subClassOf fm:Organization ;
    rdfs:label "exchange" ;
    skos:definition "An organization that lists contracts, matches orders between counterparties, and settles those contracts according to published rules." .

ksh:DesignatedContractMarket a owl:Class ;
    rdfs:subClassOf ksh:Exchange ;
    rdfs:label "designated contract market" ;
    skos:definition "An exchange authorised by a governmental regulator to list contracts for public trading." ;
    skos:example "Kalshi, as a CFTC-designated contract market." .

ksh:Kalshi a ksh:DesignatedContractMarket, owl:NamedIndividual ;
    rdfs:label "Kalshi" ;
    skos:definition "The CFTC-designated contract market that lists the weather markets this ontology models." .

################################################################
# Listings
#
# NOTE ON 'EVENT'. Kalshi's API calls its middle tier an "event". It is not
# an occurrent, and it is not a BFO event. It is an information content
# entity: a grouping of markets that partition the possible values of one
# observation target. The occurrent it concerns (the weather actually
# happening) is a separate entity, related through the proposition. Every
# class below that mirrors a Kalshi API object is an information content
# entity for this reason.
################################################################

ksh:Listing a owl:Class ;
    rdfs:subClassOf fm:DirectiveInformationEntity ;
    rdfs:label "listing" ;
    skos:definition "A directive information entity published by an exchange that specifies contracts available for trading and the rules under which they resolve." .

ksh:Series a owl:Class ;
    rdfs:subClassOf ksh:Listing ;
    rdfs:label "series" ;
    skos:definition "A listing that serves as a template for recurring event groupings sharing a common format, settlement source, and rule set." ;
    skos:example "KXHIGHNY, the daily high temperature series for New York." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty ksh:settlementSource ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ksh:EventGrouping a owl:Class ;
    rdfs:subClassOf ksh:Listing ;
    rdfs:label "event grouping" ;
    skos:altLabel "event" ;
    skos:definition "A listing, instantiating a series, that groups the markets covering one occasion; its markets range over the possible values of a single observation target." ;
    skos:example "KXHIGHNY-26AUG15, grouping the temperature bracket markets for 15 August 2026." ;
    skos:scopeNote """Named 'event grouping' rather than 'event' deliberately. Kalshi's term collides with
BFO's occurrent vocabulary, and conflating the two is the single most likely modelling error
in this domain: it invites treating a row in an API response as though it were the weather.
skos:altLabel preserves the source term for lookup.""" .

ksh:Market a owl:Class ;
    rdfs:subClassOf ksh:Listing ;
    rdfs:label "market" ;
    skos:definition "A listing within an event grouping that expresses exactly one proposition and in which contracts paying out on the truth of that proposition are traded." ;
    skos:example "KXHIGHNY-26AUG15-B82.5, expressing that the high is in the 82 to 83 degree bracket." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty ksh:expressesProposition ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ; owl:onProperty ksh:inEventGrouping ;      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ksh:WeatherMarket a owl:Class ;
    rdfs:subClassOf ksh:Market ;
    rdfs:label "weather market" ;
    skos:definition "A market whose proposition has a weather observation target as its subject." ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        ksh:Market
        [ a owl:Restriction ; owl:onProperty ksh:expressesProposition ;
          owl:someValuesFrom [ a owl:Restriction ; owl:onProperty fm:hasSubject ;
                               owl:someValuesFrom wx:WeatherObservationTarget ] ] ) ] .

# The three tiers are what the model keeps apart; one individual in two of them is the error.
[] a owl:AllDisjointClasses ;
   owl:members ( ksh:Series ksh:EventGrouping ksh:Market ) .

ksh:MarketRules a owl:Class ;
    rdfs:subClassOf fm:DirectiveInformationEntity ;
    rdfs:label "market rules" ;
    skos:definition "A directive information entity stating the condition under which a market resolves yes, the source consulted, and the handling of unavailable or corrected source data." .

ksh:SettlementSource a owl:Class ;
    rdfs:subClassOf fm:InformationContentEntity ;
    rdfs:label "settlement source" ;
    skos:definition "An information content entity designating the publication that an exchange consults, to the exclusion of others, to determine the truth value of a market's proposition." ;
    skos:example "The Weather Company daily temperature report for the relevant observing site, which Kalshi adopted for its daily temperature series on 2026-08-14 in place of the NWS Climatological Report (Daily)." ;
    skos:scopeNote """Designating the source is what makes a market's proposition determinate. Two markets with
identical wording but different settlement sources express different propositions. Not a
hypothetical: Kalshi's daily temperature series moved from the NWS to The Weather Company on
2026-08-14, so markets worded identically either side of that date do not share a proposition,
and a series of them is not one time series.""" .

################################################################
# Contracts and positions
################################################################

ksh:BinaryContract a owl:Class ;
    rdfs:subClassOf fm:InformationContentEntity ;
    rdfs:label "binary contract" ;
    skos:definition "An information content entity specifying an agreement to pay a fixed sum to its holder if the proposition of its market is true at settlement, and nothing otherwise." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty ksh:contractInMarket ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Class ; owl:unionOf ( ksh:YesContract ksh:NoContract ) ] ;
    skos:scopeNote """The union is the exhaustiveness half of a partition; ksh:YesContract owl:disjointWith
ksh:NoContract is the exclusivity half. Read it precisely: it does not refuse a third subclass,
it forces one into ksh:YesContract or ksh:NoContract, so minting an undecorated third side stays
consistent and correctly so. What it refuses is a side that is genuinely a third -- disjoint
from both -- and what it buys is the inference that a binary contract known not to be one side
is the other. A scalar market settles to a number rather than to a side and is not this case.""" ;
    skos:editorialNote "The scalar market is an open question in README.md." .

ksh:YesContract a owl:Class ;
    rdfs:subClassOf ksh:BinaryContract ; rdfs:label "yes contract" ;
    owl:disjointWith ksh:NoContract ;
    skos:definition "A binary contract that pays its holder if the market's proposition is true." ;
    skos:scopeNote """Disjoint from ksh:NoContract because the asserted class is where a lot's side lives:
the paying side is read off it. A lot typed both would let a payout pay the losing side.""" ;
    skos:editorialNote "scripts/validate.py reads the paying side off the asserted class and CQ8 binds ?side from it, so a lot typed both would pass every check." .

ksh:NoContract a owl:Class ;
    rdfs:subClassOf ksh:BinaryContract ; rdfs:label "no contract" ;
    skos:definition "A binary contract that pays its holder if the market's proposition is false." .

ksh:TraderRole a owl:Class ;
    rdfs:subClassOf fm:AgentRole ;
    rdfs:label "trader role" ;
    skos:definition "An agent role borne by a person or organization in virtue of an agreement with an exchange, realized in the placing of orders." .

ksh:ContractHolderObligation a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000023 ;   # role
    rdfs:label "contract holder obligation" ;
    skos:definition "A role borne by a party to a binary contract, realized in the transfer of funds that occurs at settlement." ;
    skos:scopeNote "A role rather than a disposition: it is grounded in an institutional arrangement external to the bearer's physical make-up, not in that make-up." .

ksh:Position a owl:Class ;
    rdfs:subClassOf fm:InformationContentEntity ;
    rdfs:label "position" ;
    skos:definition "An information content entity recording the net quantity of yes and no contracts in a market held by one trader as of a reference time." .

ksh:ContractSide a owl:Class ;
    rdfs:subClassOf fm:Designation ;
    rdfs:label "contract side" ;
    skos:definition "A designation of which of a binary market's two contracts an order, or a level of its order book, concerns." ;
    skos:scopeNote """Mirrors the API's `side` field, which is orthogonal to `action`: selling yes and buying
no leave a trader in economically similar places but are recorded as different orders, and
collapsing them here would lose the distinction the exchange actually books.""" .

ksh:YesSide a ksh:ContractSide, owl:NamedIndividual ; rdfs:label "yes side" ; skos:notation "yes"^^ksh:SideCode ;
    skos:definition "The side whose contracts pay out if the market's proposition is true." .
ksh:NoSide  a ksh:ContractSide, owl:NamedIndividual ; rdfs:label "no side" ; skos:notation "no"^^ksh:SideCode ;
    skos:definition "The side whose contracts pay out if the market's proposition is false." .

[] a owl:AllDifferent ;
   owl:distinctMembers ( ksh:YesSide ksh:NoSide ) .

ksh:OrderAction a owl:Class ;
    rdfs:subClassOf fm:Designation ;
    rdfs:label "order action" ;
    skos:definition "A designation of whether an order acquires or disposes of contracts on its side of the market." .

ksh:Buy  a ksh:OrderAction, owl:NamedIndividual ; rdfs:label "buy" ; skos:notation "buy"^^ksh:ActionCode ;
    skos:definition "The order acquires contracts on its side, paying the price stated." .
ksh:Sell a ksh:OrderAction, owl:NamedIndividual ; rdfs:label "sell" ; skos:notation "sell"^^ksh:ActionCode ;
    skos:definition "The order disposes of contracts on its side, receiving the price stated." .

[] a owl:AllDifferent ;
   owl:distinctMembers ( ksh:Buy ksh:Sell ) .

################################################################
# Trading processes
################################################################

ksh:Order a owl:Class ;
    rdfs:subClassOf fm:DirectiveInformationEntity ;
    rdfs:label "order" ;
    skos:definition "A directive information entity submitted by a trader instructing an exchange to buy or sell a stated quantity of contracts in a market, subject to stated price and time conditions." .

ksh:OrderPlacement a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000015 ;   # process
    rdfs:label "order placement" ;
    skos:definition "A process in which a trader submits an order to an exchange." .

ksh:Trade a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000015 ;   # process
    rdfs:label "trade" ;
    skos:definition "A process in which an exchange matches two orders, bringing into existence binary contracts held by the two counterparties at an agreed price." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fm:hasOutput ; owl:someValuesFrom ksh:BinaryContract ] .

ksh:Quote a owl:Class ;
    rdfs:subClassOf fm:MeasurementDatum ;
    rdfs:label "quote" ;
    skos:definition "A measurement datum reporting the best bid and offer, or the last traded price, in a market as of a reference time." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty ksh:quoteForMarket ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ksh:OrderBookSnapshot a owl:Class ;
    rdfs:subClassOf fm:MeasurementDatum ;
    rdfs:label "order book snapshot" ;
    skos:definition "A measurement datum reporting the resting order quantities at each price level in a market as of a reference time." .

ksh:PriceLevel a owl:Class ;
    rdfs:subClassOf fm:MeasurementDatum ;
    rdfs:label "price level" ;
    skos:definition "A measurement datum reporting the quantity of contracts resting on one side of a market at one price, as of the reference time of the snapshot it is part of." ;
    skos:scopeNote """Related to its snapshot by BFO's has continuant part, the way a daily report carries its
observation datum, rather than by a bespoke property. Prices are stated on the level's own
side: a yes ask of 62 appears here as a no level at 38, which is how the exchange books it.""" .

################################################################
# Settlement
################################################################

ksh:MarketSettlement a owl:Class ;
    rdfs:subClassOf fm:EvaluationProcess ;
    rdfs:label "market settlement" ;
    skos:definition "An evaluation process in which an exchange consults a market's settlement source, assigns a truth value to that market's proposition, and thereby determines which contracts pay out." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty fm:hasInput ;  owl:someValuesFrom fm:Document ] ,
        [ a owl:Restriction ; owl:onProperty fm:hasOutput ; owl:someValuesFrom ksh:Resolution ] .

ksh:Payout a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000015 ;   # process
    rdfs:label "payout" ;
    skos:definition "A process in which an exchange transfers funds to the holder of one lot of contracts determined to pay out by a market settlement, realizing that holder's contract holder obligation." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fm:hasInput ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass ksh:BinaryContract ] ;
    skos:scopeNote """One lot per payout, not one per market: the amount is checked against that lot's
quantity, which means nothing summed over several, and the obligation realized is
one holder's. With ksh:YesContract disjoint from ksh:NoContract, two lots on opposite sides
is a HermiT inconsistency rather than an unchecked amount.""" ;
    skos:editorialNote "check_payouts in scripts/validate.py checks the amount against the lot's quantity." .

ksh:Resolution a owl:Class ;
    rdfs:subClassOf fm:InformationContentEntity ;
    rdfs:label "resolution" ;
    skos:definition "An information content entity issued by an exchange stating the outcome of a market and the value determined for its observation target." .

ksh:ResolutionOutcome a owl:Class ;
    rdfs:subClassOf fm:Designation ;
    rdfs:label "resolution outcome" ;
    skos:definition "A designation of how a market resolved." .

ksh:ResolvedYes  a ksh:ResolutionOutcome, owl:NamedIndividual ; rdfs:label "resolved yes" ; skos:notation "yes"^^ksh:ResultCode ;
    skos:definition "The market's proposition was assigned the value true; yes contracts pay out." .
ksh:ResolvedNo   a ksh:ResolutionOutcome, owl:NamedIndividual ; rdfs:label "resolved no" ; skos:notation "no"^^ksh:ResultCode ;
    skos:definition "The market's proposition was assigned the value false; no contracts pay out." .
ksh:ResolvedScalar a ksh:ResolutionOutcome, owl:NamedIndividual ; rdfs:label "resolved scalar" ; skos:notation "scalar"^^ksh:ResultCode ;
    skos:definition "The market was determined to a numeric value rather than a truth value, and contracts pay out in proportion to it." ;
    skos:scopeNote "Applies to markets whose market_type is scalar rather than binary. No such market is modelled here; the individual exists so that the outcome enumeration matches the API's." .
ksh:Voided       a ksh:ResolutionOutcome, owl:NamedIndividual ; rdfs:label "voided" ;
    skos:definition "The market was cancelled without determining a truth value; consideration is returned to both sides." ;
    skos:scopeNote """No API `result` value corresponds to this. The documented enumeration is yes, no, scalar,
and empty; 8000 sampled settled markets returned only yes and no. Voiding is a real exchange
action but is evidently not recorded in the result field, so this individual is retained on
institutional grounds and carries no skos:notation: it is never produced from API data.""" .

[] a owl:AllDifferent ;
   owl:distinctMembers ( ksh:ResolvedYes ksh:ResolvedNo ksh:ResolvedScalar ksh:Voided ) .

ksh:MarketStatus a owl:Class ;
    rdfs:subClassOf fm:Designation ;
    rdfs:label "market status" ;
    skos:definition "A designation of a market's position in its lifecycle." ;
    skos:scopeNote """These individuals mirror the `status` field returned on a market. They are NOT the vocabulary
accepted by the `GET /markets?status=` filter, which is a coarser set (unopened, open, paused,
closed, settled) mapping many-to-one onto these. Versions through 0.6.0 enumerated the filter
values by mistake; `settled` in particular is a filter value only, and the terminal status is
`finalized`.""" .

ksh:Initialized a ksh:MarketStatus, owl:NamedIndividual ; rdfs:label "initialized" ; skos:notation "initialized"^^ksh:StatusCode ;
    skos:definition "The market exists but has not opened for trading; it becomes active when its open time passes." .
ksh:Active      a ksh:MarketStatus, owl:NamedIndividual ; rdfs:label "active" ; skos:notation "active"^^ksh:StatusCode ;
    skos:definition "Orders may be placed and matched." .
ksh:Inactive    a ksh:MarketStatus, owl:NamedIndividual ; rdfs:label "inactive" ; skos:notation "inactive"^^ksh:StatusCode ;
    skos:definition "Trading is paused by the exchange without the market having closed; resting orders are cancelled if it is reactivated." .
ksh:Closed      a ksh:MarketStatus, owl:NamedIndividual ; rdfs:label "closed" ; skos:notation "closed"^^ksh:StatusCode ;
    skos:definition "The close time has passed and no further orders are accepted, but no outcome has been determined." .
ksh:Determined  a ksh:MarketStatus, owl:NamedIndividual ; rdfs:label "determined" ; skos:notation "determined"^^ksh:StatusCode ;
    skos:definition "An outcome has been assigned and the settlement timer is running, during which the outcome may still be disputed." ;
    skos:scopeNote "The state a ksh:MarketSettlement leaves a market in: a resolution exists, but no funds have moved and the outcome is still contestable. ksh:Payout carries it to ksh:Finalized. Collapsing the two loses that window." .
ksh:Disputed    a ksh:MarketStatus, owl:NamedIndividual ; rdfs:label "disputed" ; skos:notation "disputed"^^ksh:StatusCode ;
    skos:definition "The determined outcome has been challenged and may be determined again." .
ksh:Amended     a ksh:MarketStatus, owl:NamedIndividual ; rdfs:label "amended" ; skos:notation "amended"^^ksh:StatusCode ;
    skos:definition "The market was determined again following a dispute, restarting the settlement timer." .
ksh:Finalized   a ksh:MarketStatus, owl:NamedIndividual ; rdfs:label "finalized" ; skos:notation "finalized"^^ksh:StatusCode ;
    skos:definition "Settlement is complete and positions have been paid out; the market is in its terminal state." .

[] a owl:AllDifferent ;
   owl:distinctMembers ( ksh:Initialized ksh:Active ksh:Inactive ksh:Closed
                         ksh:Determined ksh:Disputed ksh:Amended ksh:Finalized ) .

################################################################
# All nine designation vocabularies are pairwise disjoint
#
# The AllDifferent blocks separate each vocabulary's individuals from each other,
# not the vocabularies from one another: without this, ksh:ResolvedYes could double
# as fm:True and every functional-property guard would still pass. Every subclass of
# fm:Designation is a member; core.ttl asserts its five again on its own, so nothing
# is lost by importing core without this module.
################################################################

[] a owl:AllDisjointClasses ;
   owl:members ( fm:TruthValue fm:Comparator fm:ScoringRule
                 qudt:QuantityKind qudt:QuantityKindDimensionVector
                 ksh:ContractSide ksh:OrderAction ksh:ResolutionOutcome
                 ksh:MarketStatus ) .

################################################################
# API codes
#
# One datatype per API field, not one for all: "yes" is both a result and a side,
# and a typed literal keeps the two apart. shapes/vocabulary.ttl holds the documented
# enumerations and checks the notations against them.
################################################################

# Declared the way bfo-core declares the SKOS annotations it uses. OWLAPI would infer
# it; declaring it keeps the typed literals out of HermiT's view by statement, not guess.
skos:notation a owl:AnnotationProperty .
# An IRI object, so undeclared it could be read as an object property on a tombstone.
dcterms:isReplacedBy a owl:AnnotationProperty .

ksh:StatusCode a rdfs:Datatype ;
    rdfs:label "status code" ;
    skos:definition "The string the Kalshi API returns in a market's `status` field." .

ksh:ResultCode a rdfs:Datatype ;
    rdfs:label "result code" ;
    skos:definition "The string the Kalshi API returns in a market's `result` field." ;
    skos:scopeNote "The empty string is a documented result and has no designation: a market with no result has not resolved, which is the absence of a ksh:ResolutionOutcome rather than one of them." .

ksh:SideCode a rdfs:Datatype ;
    rdfs:label "side code" ;
    skos:definition "The string the Kalshi API uses in an order's `side` field." .

ksh:ActionCode a rdfs:Datatype ;
    rdfs:label "action code" ;
    skos:definition "The string the Kalshi API uses in an order's `action` field." .

ksh:StrikeTypeCode a rdfs:Datatype ;
    rdfs:label "strike type code" ;
    skos:definition "The string the Kalshi API returns in a market's `strike_type` field." .

# A field name is typed by the API schema it belongs to: `ticker` and `yes_price_dollars`
# each name different things in different schemas.
ksh:MarketFieldName a rdfs:Datatype ;
    rdfs:label "market field name" ;
    skos:definition "The name of a field of the Kalshi API's Market object." .

ksh:EventFieldName a rdfs:Datatype ;
    rdfs:label "event field name" ;
    skos:definition "The name of a field of the Kalshi API's event object (EventData)." .

ksh:SeriesFieldName a rdfs:Datatype ;
    rdfs:label "series field name" ;
    skos:definition "The name of a field of the Kalshi API's Series object." .

ksh:OrderFieldName a rdfs:Datatype ;
    rdfs:label "order field name" ;
    skos:definition "The name of a field of the Kalshi API's Order object." .

ksh:TradeFieldName a rdfs:Datatype ;
    rdfs:label "trade field name" ;
    skos:definition "The name of a field of the Kalshi API's Trade object." .

ksh:PositionFieldName a rdfs:Datatype ;
    rdfs:label "position field name" ;
    skos:definition "The name of a field of the Kalshi API's MarketPosition object." .

################################################################
# Strike types
#
# The comparators are core terms; their Kalshi codes live here so the core stays
# venue-neutral. Two strike types have no core counterpart and are minted here.
################################################################

fm:GreaterThan        skos:notation "greater"^^ksh:StrikeTypeCode .
fm:GreaterThanOrEqual skos:notation "greater_or_equal"^^ksh:StrikeTypeCode .
fm:LessThan           skos:notation "less"^^ksh:StrikeTypeCode .
fm:LessThanOrEqual    skos:notation "less_or_equal"^^ksh:StrikeTypeCode .
fm:Between            skos:notation "between"^^ksh:StrikeTypeCode .
fm:Custom             skos:notation "custom"^^ksh:StrikeTypeCode .
fm:EqualTo skos:scopeNote "Carries no Kalshi strike_type code: the API documents no equality strike (Trade API 3.31.0)." .

ksh:FunctionalStrike a fm:Comparator, owl:NamedIndividual ;
    rdfs:label "functional strike" ;
    skos:notation "functional"^^ksh:StrikeTypeCode ;
    skos:definition "The market settles to a value given by a stated mapping from the realized value, rather than to the truth of a threshold comparison." ;
    skos:scopeNote "Defined from the API schema alone, which describes `functional_strike` as a mapping from expiration values to settlement values and nothing more (Kalshi Trade API 3.31.0, checked 2026-09-25). It strains fm:Comparator's definition, which is about the truth of a proposition, and sits closer to the unmodelled scalar market than to a binary one." ;
    skos:editorialNote "No example uses it." .

ksh:StructuredStrike a fm:Comparator, owl:NamedIndividual ;
    rdfs:label "structured strike" ;
    skos:notation "structured"^^ksh:StrikeTypeCode ;
    skos:definition "The condition names entities from the exchange's catalogue of structured targets, and holds according to the outcome recorded for them rather than against a numeric threshold." ;
    skos:scopeNote "Defined from the API schema alone: `strike_type` lists `structured`, and the `/structured_targets` endpoint catalogues named targets with their competitions; no prose describes the strike type (Kalshi Trade API 3.31.0, checked 2026-09-25). No weather market is known to use it." .

# The core's AllDifferent covers its seven; this one adds the two minted here.
[] a owl:AllDifferent ;
   owl:distinctMembers ( fm:GreaterThan fm:GreaterThanOrEqual fm:LessThan fm:LessThanOrEqual
                         fm:Between fm:EqualTo fm:Custom ksh:FunctionalStrike ksh:StructuredStrike ) .

################################################################
# Pricing and implied probability
################################################################

ksh:PriceToProbabilityDerivation a owl:Class ;
    rdfs:subClassOf fm:InformationProcess ;
    rdfs:label "price to probability derivation" ;
    skos:definition "An information process taking a quote as input and yielding a market implied probability, according to a stated transformation." ;
    skos:scopeNote """Kalshi prices yes contracts between zero and one dollar on a per-market tick grid, so
the naive transformation is the price in cents divided by one hundred. It is naive: it ignores
the bid-ask spread, trading and settlement fees, the time value of collateral posted until settlement, and
any risk premium. Recording the derivation as a process, with the quote as its input, keeps
those choices auditable instead of burying them in a column.""" .

################################################################
# Object properties
################################################################

ksh:inSeries a owl:ObjectProperty ;
    rdfs:label "in series" ;
    rdfs:domain ksh:EventGrouping ; rdfs:range ksh:Series ;
    a owl:FunctionalProperty ;
    skos:definition "Relates an event grouping to the series it instantiates." .

ksh:inEventGrouping a owl:ObjectProperty ;
    rdfs:label "in event grouping" ;
    rdfs:domain ksh:Market ; rdfs:range ksh:EventGrouping ;
    a owl:FunctionalProperty ;
    owl:inverseOf ksh:hasMarket ;
    skos:definition "Relates a market to the event grouping it belongs to." .

ksh:hasMarket a owl:ObjectProperty ; rdfs:label "has market" ;
    skos:definition "Relates an event grouping to a market it contains." .

ksh:expressesProposition a owl:ObjectProperty ;
    rdfs:label "expresses proposition" ;
    rdfs:domain ksh:Market ; rdfs:range fm:Proposition ;
    a owl:FunctionalProperty ;
    skos:definition "Relates a market to the proposition whose truth value determines which of its contracts pay out." ;
    skos:scopeNote "The join point between this module and the weather module." .

ksh:coversTarget a owl:ObjectProperty ;
    rdfs:label "covers target" ;
    rdfs:domain ksh:EventGrouping ; rdfs:range fm:ObservationTarget ;
    skos:definition "Relates an event grouping to the observation target whose possible values its markets range over." .

ksh:settlementSource a owl:ObjectProperty ;
    rdfs:label "has settlement source" ;
    rdfs:range ksh:SettlementSource ;
    skos:definition "Relates a listing to the settlement source that will be consulted to determine the truth value of its proposition." .

ksh:sourceProtocol a owl:ObjectProperty ;
    rdfs:label "source protocol" ;
    rdfs:domain ksh:SettlementSource ; rdfs:range wx:MeasurementProtocol ;
    skos:definition "Relates a settlement source to the measurement protocol under which it determines the values it publishes." ;
    skos:scopeNote """Without this, ksh:settlementSource and wx:underProtocol are two unconnected statements of
one fact: which publication the exchange consults, and how the value it publishes is
determined. Nothing stopped them disagreeing, so a market could settle on The Weather
Company while its proposition named an NWS-determined target -- the 2026-08-14 migration
as a modelling error rather than a data one. Asserting this is what makes the two
comparable.""" ;
    skos:editorialNote "check_protocols in scripts/validate.py compares them." .

ksh:hasRules a owl:ObjectProperty ;
    rdfs:subPropertyOf fm:governedBy ;
    rdfs:label "has rules" ;
    rdfs:range ksh:MarketRules ;
    skos:definition "Relates a listing to the market rules governing its resolution." .

ksh:contractInMarket a owl:ObjectProperty ;
    rdfs:label "contract in market" ;
    rdfs:domain ksh:BinaryContract ; rdfs:range ksh:Market ;
    a owl:FunctionalProperty ;
    skos:definition "Relates a binary contract to the market whose proposition determines whether it pays out." .

ksh:datumForMarket a owl:ObjectProperty ;
    rdfs:label "datum for market" ;
    rdfs:domain fm:MeasurementDatum ; rdfs:range ksh:Market ;
    skos:definition "Relates a measurement datum reporting on trading to the market it reports on." ;
    skos:scopeNote "Quotes and order book snapshots both report on one market. ksh:quoteForMarket is the functional specialisation for quotes; snapshots use this directly." .

ksh:quoteForMarket a owl:ObjectProperty ;
    rdfs:subPropertyOf ksh:datumForMarket ;
    rdfs:label "quote for market" ;
    rdfs:domain ksh:Quote ; rdfs:range ksh:Market ;
    a owl:FunctionalProperty ;
    skos:definition "Relates a quote to the market whose prices it reports." .

ksh:orderInMarket a owl:ObjectProperty ;
    rdfs:label "order in market" ;
    rdfs:domain ksh:Order ; rdfs:range ksh:Market ;
    a owl:FunctionalProperty ;
    skos:definition "Relates an order to the market whose contracts it instructs the exchange to buy or sell." .

ksh:hasSide a owl:ObjectProperty ;
    rdfs:label "has side" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ksh:Order ksh:PriceLevel ) ] ;
    rdfs:range ksh:ContractSide ;
    a owl:FunctionalProperty ;
    skos:definition "Relates an order, or a level of an order book, to the side of the market it concerns." .

ksh:hasAction a owl:ObjectProperty ;
    rdfs:label "has action" ;
    rdfs:domain ksh:Order ; rdfs:range ksh:OrderAction ;
    a owl:FunctionalProperty ;
    skos:definition "Relates an order to the designation of whether it acquires or disposes of contracts." .

ksh:positionInMarket a owl:ObjectProperty ;
    rdfs:label "position in market" ;
    rdfs:domain ksh:Position ; rdfs:range ksh:Market ;
    a owl:FunctionalProperty ;
    skos:definition "Relates a position to the market whose contracts it records a holding in." .

ksh:heldBy a owl:ObjectProperty ;
    rdfs:label "held by" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ksh:Position ksh:BinaryContract ) ] ;
    rdfs:range fm:Agent ;
    skos:definition "Relates a position, or a lot of contracts, to the agent bearing the trader role that holds it." ;
    skos:scopeNote "Widened from ksh:Position in 0.8.0. A trade brings contracts into existence held by the two counterparties, so a lot has a holder before any position is struck from it; a second property for the same relation would have to be kept in step with this one by hand." .

ksh:hasStatus a owl:ObjectProperty ;
    rdfs:label "has status" ;
    rdfs:domain ksh:Market ; rdfs:range ksh:MarketStatus ;
    a owl:FunctionalProperty ;
    skos:definition "Relates a market to the designation recording where it stands in its lifecycle, from initialized through active, closed, determined, and finalized." ;
    skos:scopeNote "Status changes over time; an assertion of it is true only as of a reference time, and is treated here as the current status. Model status history as a sequence of ksh:Quote-like snapshots if history matters. The range is the market status field's vocabulary, not the coarser one the markets endpoint accepts as a filter." .

ksh:resolvesTo a owl:ObjectProperty ;
    rdfs:label "resolves to" ;
    rdfs:domain ksh:Resolution ; rdfs:range ksh:ResolutionOutcome ;
    a owl:FunctionalProperty ;
    skos:definition "Relates a resolution to the designation of the outcome it records." .

ksh:resolutionOf a owl:ObjectProperty ;
    rdfs:label "resolution of" ;
    rdfs:domain ksh:Resolution ; rdfs:range ksh:Market ;
    a owl:FunctionalProperty ;
    skos:definition "Relates a resolution to the market whose outcome it states." .

ksh:derivedFromQuote a owl:ObjectProperty ;
    rdfs:label "derived from quote" ;
    rdfs:domain fm:MarketImpliedProbability ; rdfs:range ksh:Quote ;
    skos:definition "Relates a market implied probability to the quote it was computed from." .

################################################################
# Data properties
################################################################

ksh:seriesTicker a owl:DatatypeProperty ;
    rdfs:subPropertyOf fm:identifier ; rdfs:label "series ticker" ;
    rdfs:domain ksh:Series ; rdfs:range xsd:string ;
    skos:definition "The exchange's identifier for a series, naming the recurring question rather than any one occasion of it." ;
    skos:example "\"KXHIGHNY\"" .

ksh:eventTicker a owl:DatatypeProperty ;
    rdfs:subPropertyOf fm:identifier ; rdfs:label "event ticker" ;
    rdfs:domain ksh:EventGrouping ; rdfs:range xsd:string ;
    skos:definition "The exchange's identifier for one occasion of a series, naming the set of markets that share a settlement source and date." ;
    skos:example "\"KXHIGHNY-26AUG15\"" .

ksh:marketTicker a owl:DatatypeProperty ;
    rdfs:subPropertyOf fm:identifier ; rdfs:label "market ticker" ;
    rdfs:domain ksh:Market ; rdfs:range xsd:string ;
    skos:definition "The exchange's identifier for a single market, naming one bracket or condition within an event grouping." ;
    skos:example "\"KXHIGHNY-26AUG15-B82.5\"" .

ksh:mutuallyExclusive a owl:DatatypeProperty ;
    rdfs:label "mutually exclusive" ;
    rdfs:domain ksh:EventGrouping ; rdfs:range xsd:boolean ;
    skos:definition "True when at most one market in the event grouping can resolve yes." ;
    skos:scopeNote "Temperature bracket groupings are mutually exclusive and, taken together, exhaustive; their implied probabilities should sum to approximately one, and the excess over one is a useful measure of the spread and fee drag." .

ksh:yesBidDollars a owl:DatatypeProperty ; rdfs:label "yes bid dollars" ; rdfs:domain ksh:Quote ; rdfs:range xsd:decimal ;
    skos:definition "The highest price, in US dollars, at which a resting order to buy yes contracts existed as of the quote's reference time." .

ksh:yesAskDollars a owl:DatatypeProperty ; rdfs:label "yes ask dollars" ; rdfs:domain ksh:Quote ; rdfs:range xsd:decimal ;
    skos:definition "The lowest price, in US dollars, at which a resting order to sell yes contracts existed as of the quote's reference time." .
ksh:lastPriceDollars a owl:DatatypeProperty ; rdfs:label "last price dollars" ; rdfs:domain ksh:Quote ; rdfs:range xsd:decimal ;
    skos:definition "The price in US dollars at which the market's most recent trade executed, as of the quote's reference time." ;
    skos:scopeNote """Dollars against a one dollar payout per contract, so under the naive transformation the
price and the derived probability are the same number -- which is why they are two properties:
the source datum and the derived belief stay distinct. Decimal because the API emits
fixed-point strings to six places and a market's tick grid is given by its
price_level_structure; weather markets still quote whole cents, so two-place values here are
correct but incidentally so.""" .

ksh:volume a owl:DatatypeProperty ; rdfs:label "volume" ; rdfs:domain ksh:Quote ; rdfs:range xsd:decimal ;
    skos:definition "The quantity of contracts traded in the market up to the quote's reference time." ;
    skos:scopeNote "Decimal, not integer: Kalshi contracts are fractional to a granularity of 0.01, reported in the volume_fp and open_interest_fp fields. This is not an edge case — 197 of 200 sampled settled KXHIGHNY markets carried a fractional volume or open interest." .

ksh:openInterest a owl:DatatypeProperty ; rdfs:label "open interest" ; rdfs:domain ksh:Quote ; rdfs:range xsd:decimal ;
    skos:definition "The quantity of contracts outstanding and not yet settled as of the quote's reference time." ;
    skos:scopeNote "Decimal for the same reason as ksh:volume." .

ksh:orderQuantity a owl:DatatypeProperty ; rdfs:label "order quantity" ; rdfs:domain ksh:Order ; rdfs:range xsd:decimal ;
    skos:definition "The quantity of contracts the order instructs the exchange to buy or sell." ;
    skos:scopeNote "Decimal for the same reason as ksh:volume: Kalshi contracts are fractional to a granularity of 0.01." .

ksh:limitPriceDollars a owl:DatatypeProperty ; rdfs:label "limit price dollars" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ksh:Order ksh:PriceLevel ) ] ; rdfs:range xsd:decimal ;
    skos:definition "The price in US dollars, on the side concerned, at which the order or level rests: the worst price a buy will pay, or the worst a sell will accept." ;
    skos:editorialNote """Not checked against the price a trade executes at. A buy filled above its limit, or a sell
filled below one, is a real defect class and a purely local one -- both orders and the price
are in hand -- but no example exercises a partial or crossed fill, so a check would be
asserting the arithmetic of a case nothing has ever produced.""" .

ksh:restingQuantity a owl:DatatypeProperty ; rdfs:label "resting quantity" ; rdfs:domain ksh:PriceLevel ; rdfs:range xsd:decimal ;
    skos:definition "The quantity of contracts resting unfilled at the level's price and side as of the snapshot's reference time." .

ksh:executionPriceDollars a owl:DatatypeProperty ; rdfs:label "execution price dollars" ; rdfs:domain ksh:Trade ; rdfs:range xsd:decimal ;
    skos:definition "The price in US dollars at which the trade matched." ;
    skos:scopeNote "Stated on the yes side by convention, as the exchange reports it. The no side paid one dollar minus this; the two prices of a matched trade sum to the payout, which is what makes a binary market self-collateralising." .

ksh:contractQuantity a owl:DatatypeProperty ; rdfs:label "contract quantity" ; rdfs:domain ksh:BinaryContract ; rdfs:range xsd:decimal ;
    skos:definition "The quantity of contracts on identical terms that the lot comprises." ;
    skos:scopeNote "Contracts in a market are fungible, so an individual of this class is a lot brought into existence by one trade and held by one party, not a single certificate. Its terms are fixed by ksh:contractInMarket; only the quantity and the holder distinguish two lots in the same market on the same side." .

ksh:positionQuantity a owl:DatatypeProperty ; rdfs:label "position quantity" ; rdfs:domain ksh:Position ; rdfs:range xsd:decimal ;
    skos:definition "The net quantity of contracts held in the market as of the position's reference time, positive for a net yes holding and negative for a net no holding." ;
    skos:scopeNote "Signed, as the API's `position_fp` field is, rather than split into two properties: a trader is net one way or the other, and two unsigned quantities admit the meaningless state of being long both sides of the same market." .

ksh:payoutAmountCents a owl:DatatypeProperty ; rdfs:label "payout amount cents" ; rdfs:domain ksh:Payout ; rdfs:range xsd:decimal ;
    skos:definition "The sum in cents transferred to the holder by the payout." ;
    skos:scopeNote "One hundred cents per contract on the side the resolution determined, and nothing on the other. Stored rather than derived, so that the amount and the lot's quantity are two independent statements that can be compared." ;
    skos:editorialNote "check_payouts in scripts/validate.py compares them." ;
    skos:scopeNote "No API field is this. Settlement `revenue` is in cents too, but it sums every lot the holder had in the market, where a payout here pays one lot." .

ksh:openTime a owl:DatatypeProperty ; rdfs:label "open time" ; rdfs:domain ksh:Market ; rdfs:range xsd:dateTimeStamp ;
    skos:definition "The instant from which orders are accepted in the market." .
ksh:closeTime a owl:DatatypeProperty ; rdfs:label "close time" ; rdfs:domain ksh:Market ; rdfs:range xsd:dateTimeStamp ;
    skos:definition "The instant after which no further orders are matched in the market." .
ksh:expectedExpirationTime a owl:DatatypeProperty ; rdfs:label "expected expiration time" ; rdfs:domain ksh:Market ; rdfs:range xsd:dateTimeStamp ;
    skos:definition "The instant by which the market's outcome is expected to become known, being the point by which its settlement source is expected to have published." ;
    skos:scopeNote """Distinct from close time: a daily temperature market closes at the end of the
climatological day but its outcome is not known until the settlement source publishes,
some hours later. A forecast, not a commitment — the exchange may determine
the market later, and ksh:latestExpirationTime is the bound.""" .
ksh:latestExpirationTime a owl:DatatypeProperty ; rdfs:label "latest expiration time" ; rdfs:domain ksh:Market ; rdfs:range xsd:dateTimeStamp ;
    skos:definition "The instant after which the market can no longer resolve." ;
    skos:scopeNote """Through 0.6.0 a single ksh:expirationTime fused these two: it was defined as the instant
after which the market can no longer resolve, which is this property, but described as the
point by which the settlement source is expected to have published, which is
ksh:expectedExpirationTime. The two are far apart in practice — for KXHIGHNY-26AUG15-B82.5,
six hours after the close against six days after it. The API's `expiration_time`
is a deprecated legacy field carrying this value; read it from `latest_expiration_time`.""" .

# Tombstone: retired terms keep their IRI, never their declaration or axioms (ADR 0003).
ksh:expirationTime
    rdfs:label "expiration time" ;
    owl:deprecated true ;
    dcterms:isReplacedBy ksh:expectedExpirationTime , ksh:latestExpirationTime ;
    skos:historyNote "Retired in 0.7.0: it fused the instant after which a market can no longer resolve with the instant the settlement source is expected to have published, which lie days apart. Split into ksh:latestExpirationTime and ksh:expectedExpirationTime." .

ksh:yesBidCents
    rdfs:label "yes bid cents" ;
    owl:deprecated true ;
    dcterms:isReplacedBy ksh:yesBidDollars ;
    skos:historyNote "Retired in 0.19.0 (FM-0015): the Kalshi API reports this price only in dollars (yes_bid_dollars) and no longer in cents. Replaced by ksh:yesBidDollars, whose values are this property's divided by one hundred." .

ksh:yesAskCents
    rdfs:label "yes ask cents" ;
    owl:deprecated true ;
    dcterms:isReplacedBy ksh:yesAskDollars ;
    skos:historyNote "Retired in 0.19.0 (FM-0015): the Kalshi API reports this price only in dollars (yes_ask_dollars) and no longer in cents. Replaced by ksh:yesAskDollars, whose values are this property's divided by one hundred." .

ksh:lastPriceCents
    rdfs:label "last price cents" ;
    owl:deprecated true ;
    dcterms:isReplacedBy ksh:lastPriceDollars ;
    skos:historyNote "Retired in 0.19.0 (FM-0015): the Kalshi API reports this price only in dollars (last_price_dollars) and no longer in cents. Replaced by ksh:lastPriceDollars, whose values are this property's divided by one hundred." .

ksh:limitPriceCents
    rdfs:label "limit price cents" ;
    owl:deprecated true ;
    dcterms:isReplacedBy ksh:limitPriceDollars ;
    skos:historyNote "Retired in 0.19.0 (FM-0015): the Kalshi API reports this price only in dollars (yes_price_dollars and no_price_dollars) and no longer in cents. Replaced by ksh:limitPriceDollars, whose values are this property's divided by one hundred." .

ksh:executionPriceCents
    rdfs:label "execution price cents" ;
    owl:deprecated true ;
    dcterms:isReplacedBy ksh:executionPriceDollars ;
    skos:historyNote "Retired in 0.19.0 (FM-0015): the Kalshi API reports this price only in dollars (yes_price_dollars) and no longer in cents. Replaced by ksh:executionPriceDollars, whose values are this property's divided by one hundred." .

ksh:settlementValue a owl:DatatypeProperty ;
    rdfs:subPropertyOf fm:realizedValue ;
    rdfs:label "settlement value" ;
    rdfs:domain ksh:Resolution ; rdfs:range xsd:decimal ;
    skos:definition "The value the exchange determined for the observation target and applied to the market's condition." ;
    skos:scopeNote "May diverge from the value in the observational record if the settlement source issued a correction after settlement. Both are worth keeping; see wx:ReportCorrection." .

################################################################
# API field names
#
# Checked against Trade API 3.31.0 by shapes/vocabulary.ttl. FM-0015 lists what is
# unmapped on purpose and why; FM-0019 owns the deprecated `side` and `action`.
################################################################

ksh:marketTicker           skos:notation "ticker"^^ksh:MarketFieldName .
ksh:openTime               skos:notation "open_time"^^ksh:MarketFieldName .
ksh:closeTime              skos:notation "close_time"^^ksh:MarketFieldName .
ksh:expectedExpirationTime skos:notation "expected_expiration_time"^^ksh:MarketFieldName .
ksh:latestExpirationTime   skos:notation "latest_expiration_time"^^ksh:MarketFieldName .
fm:floorValue              skos:notation "floor_strike"^^ksh:MarketFieldName .
fm:capValue                skos:notation "cap_strike"^^ksh:MarketFieldName .
fm:hasComparator           skos:notation "strike_type"^^ksh:MarketFieldName .
ksh:yesBidDollars          skos:notation "yes_bid_dollars"^^ksh:MarketFieldName .
ksh:yesAskDollars          skos:notation "yes_ask_dollars"^^ksh:MarketFieldName .
ksh:lastPriceDollars       skos:notation "last_price_dollars"^^ksh:MarketFieldName .
ksh:volume                 skos:notation "volume_fp"^^ksh:MarketFieldName .
ksh:openInterest           skos:notation "open_interest_fp"^^ksh:MarketFieldName .
ksh:settlementValue        skos:notation "expiration_value"^^ksh:MarketFieldName .
ksh:hasStatus              skos:notation "status"^^ksh:MarketFieldName .
ksh:resolvesTo             skos:notation "result"^^ksh:MarketFieldName .
ksh:inEventGrouping        skos:notation "event_ticker"^^ksh:MarketFieldName .
ksh:eventTicker            skos:notation "event_ticker"^^ksh:EventFieldName .
ksh:mutuallyExclusive      skos:notation "mutually_exclusive"^^ksh:EventFieldName .
ksh:inSeries               skos:notation "series_ticker"^^ksh:EventFieldName .
ksh:seriesTicker           skos:notation "ticker"^^ksh:SeriesFieldName .
ksh:orderInMarket          skos:notation "ticker"^^ksh:OrderFieldName .
ksh:orderQuantity          skos:notation "initial_count_fp"^^ksh:OrderFieldName .
ksh:hasSide                skos:notation "side"^^ksh:OrderFieldName .
ksh:hasAction              skos:notation "action"^^ksh:OrderFieldName .
ksh:executionPriceDollars  skos:notation "yes_price_dollars"^^ksh:TradeFieldName .
ksh:contractQuantity       skos:notation "count_fp"^^ksh:TradeFieldName .
ksh:positionQuantity       skos:notation "position_fp"^^ksh:PositionFieldName .
ksh:positionInMarket       skos:notation "ticker"^^ksh:PositionFieldName .
