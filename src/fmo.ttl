@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/forecast-market-ontology/fmo>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/forecast-market-ontology/fmo/0.11.0> ;
    owl:imports
        <https://w3id.org/forecast-market-ontology/core> ,
        <https://w3id.org/forecast-market-ontology/weather> ,
        <https://w3id.org/forecast-market-ontology/kalshi> ;
    dcterms:title "Forecast-Market Ontology" ;
    dcterms:description """An application ontology relating weather forecasts to prediction market
listings on those forecasts, built on Basic Formal Ontology 2020.

Import this module to get everything. Import the individual modules if you want only the
meteorological or only the market vocabulary; core is a dependency of both.""" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.11.0" .
