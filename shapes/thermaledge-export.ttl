@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix fm:   <https://w3id.org/forecast-market-ontology/core#> .
@prefix wx:   <https://w3id.org/forecast-market-ontology/weather#> .
@prefix ksh:  <https://w3id.org/forecast-market-ontology/kalshi#> .
@prefix teh:  <https://w3id.org/forecast-market-ontology/shapes/thermaledge#> .

# What a valid ThermalEdge export looks like. Deliberately the minimum CQ2 and
# CQ4 need: the export omits sites, stations, day boundaries, model runs and
# quotes, and these shapes must not demand them back.

# Targets ksh:Market, not ksh:WeatherMarket. rdfs inference types a weather
# market as a market but not the reverse, so targeting the subclass let an export
# whose markets are typed ksh:Market match no focus node at all -- and a shape
# with no focus nodes CONFORMS. A market with no proposition and no ticker passed.
teh:MarketShape a sh:NodeShape ;
    sh:targetClass ksh:Market ;
    sh:property [
        sh:path ksh:expressesProposition ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "every market expresses exactly one proposition" ;
    ] ;
    sh:property [
        sh:path ksh:marketTicker ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#string> ;
    ] .

teh:PropositionShape a sh:NodeShape ;
    sh:targetClass fm:Proposition ;
    sh:property [
        sh:path fm:hasSubject ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class wx:WeatherObservationTarget ;
        sh:message "a proposition's subject must be a weather observation target" ;
    ] ;
    sh:property [
        sh:path fm:hasComparator ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

teh:TargetShape a sh:NodeShape ;
    sh:targetClass wx:WeatherObservationTarget ;
    sh:property [
        sh:path wx:underProtocol ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "a target without a protocol is not identified: the same site and day under two protocols are two quantities" ;
    ] .

# No sh:class here, and none on fm:assignsProbabilityTo below. THE RULE: sh:class C
# on a property whose rdfs:range is already C is dead code, because validate_shapes.py
# runs with inference="rdfs" and range entailment types the object BEFORE SHACL looks.
# Both constraints existed and neither could ever fire -- a dangling protocol IRI was
# entailed into wx:MeasurementProtocol and conformed. Catch a bad protocol by requiring
# something inference cannot fabricate: a literal.
teh:ProtocolShape a sh:NodeShape ;
    sh:targetClass wx:MeasurementProtocol ;
    sh:property [
        sh:path fm:statedAs ;
        sh:minCount 1 ;
        sh:message "a protocol must state its rules; an IRI entailed into the class by rdfs:range carries none" ;
    ] .

# Targets the PARENT, fm:ProbabilityAssignment, for the same reason MarketShape
# targets ksh:Market: rdfs types a subclass instance as the parent, never the
# reverse. Targeting the two leaves let an export typing its probabilities as
# fm:ProbabilityAssignment -- or leaving them untyped, since the domain of
# fm:probabilityValue supplies the parent and nothing else -- match no focus node
# and conform with a probability of 7.41.
teh:ProbabilityShape a sh:NodeShape ;
    sh:targetClass fm:ProbabilityAssignment ;
    sh:property [
        sh:path fm:assignsProbabilityTo ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "a probability must assign to exactly one proposition" ;
    ] ;
    sh:property [
        sh:path fm:probabilityValue ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
    ] .
