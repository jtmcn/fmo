# CQ4. What document settled this market, and what value did it report?
#
# Settlement is an evaluation process with a document as input and a resolution
# as output, so the provenance chain is walkable rather than being an opaque
# "settled: yes" flag. That matters for the case in CQ7: when a correction is
# issued after settlement, you need to know which document the exchange actually
# read, not merely what the current authoritative value is.
#
# ?settlementValue is what the exchange applied. ?reportedValue is what the
# document it read says. They agree here, and are kept separate precisely because
# they can diverge -- CQ7 shows the case where a correction makes them disagree.
#
# NOTE ON TYPE MATCHING. Class patterns below use `a/rdfs:subClassOf*` rather than
# plain `a`. SPARQL does no subclass reasoning, so `?m a ksh:Market` does NOT match
# an individual asserted as ksh:WeatherMarket -- this query returned zero rows until
# the path was added. The property-path form keeps the queries runnable against the
# raw graph without a reasoner in the loop.

SELECT ?ticker ?outcome ?settlementValue ?document ?issuer ?reportedValue ?assessedAtSettlement
WHERE {
    ?settlement a/rdfs:subClassOf* ksh:MarketSettlement ;
                fm:hasInput  ?document ;
                fm:hasOutput ?resolution .

    ?resolution ksh:resolutionOf ?market ;
                ksh:resolvesTo   ?outcome .
    OPTIONAL { ?resolution ksh:settlementValue ?settlementValue }

    ?market ksh:marketTicker ?ticker ;
            ksh:expressesProposition ?proposition .

    # The observation target, needed below to pick the right datum out of the document.
    ?proposition fm:hasSubject ?target .

    # The truth value assessed FROM THIS DOCUMENT. Bound to ?document rather than
    # read off the proposition, because a later correction produces a second
    # assessment of the same proposition with the opposite value -- see CQ7.
    OPTIONAL {
        ?assessment fm:assessesProposition ?proposition ;
                    fm:basedOnRecord ?document ;
                    fm:assessedTruthValue ?assessedAtSettlement .
    }

    OPTIONAL { ?document fm:issuedBy ?issuer }

    # The datum inside the document that carries the number FOR THIS MARKET'S TARGET.
    # A CLI product carries max temperature, min temperature and precipitation, so
    # without wx:reportsValueFor the walk returns every datum in the document and
    # reports the minimum temperature as the value a max-temperature market settled on.
    OPTIONAL {
        ?document bfo:BFO_0000178 ?datum .
        ?datum wx:reportsValueFor ?target ;
               fm:realizedValue ?reportedValue .
    }
}
ORDER BY ?ticker
