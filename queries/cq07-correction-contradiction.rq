# CQ7. Which settled markets were contradicted by a later correction to their
# settlement source?
#
# NWS reissues CLI products when a sensor fault or transcription error is found,
# sometimes days after the fact. Exchanges generally do not re-settle. So the
# observational record and the exchange's payout permanently disagree, and both
# are correct about what they record. That separation is why ksh:settlementValue
# and fm:realizedValue are distinct properties rather than one field.
#
# The verdict is COMPUTED, not looked up: the query re-evaluates each proposition's
# comparator and thresholds against the currently authoritative value and compares
# the result to what the exchange actually did. ?recordedAssessment is the stored
# fm:TruthAssessment for the same document, carried alongside as a cross-check --
# if it ever disagrees with ?impliedOutcome, the stored assessment is wrong.
#
# RETURNS EVERY AFFECTED MARKET, not only the contradicted ones. Filtering to
# contradictions would return zero rows whenever a correction happened to change
# nothing, which the runner treats as failure -- and would also hide the useful
# fact that a correction was issued and checked. Read the ?verdict column.
#
# LIMITATION: fm:Custom conditions are not evaluable here. They are stated in
# natural language in the market rules and need a human. They are excluded by the
# comparator filter rather than silently defaulting to "consistent".

SELECT ?ticker ?settledOutcome ?settlementValue ?currentValue
       ?impliedOutcome ?verdict ?recordedAssessment ?currentDocument
WHERE {
    ?resolution ksh:resolutionOf ?market ;
                ksh:resolvesTo   ?settledOutcome .
    OPTIONAL { ?resolution ksh:settlementValue ?settlementValue }

    ?market ksh:marketTicker ?ticker ;
            ksh:expressesProposition ?proposition .

    ?proposition fm:hasSubject ?target ;
                 fm:hasComparator ?comparator .
    OPTIONAL { ?proposition fm:floorValue ?floor }
    OPTIONAL { ?proposition fm:capValue   ?cap }

    FILTER(?comparator IN (fm:Between, fm:LessThan, fm:LessThanOrEqual,
                           fm:GreaterThan, fm:GreaterThanOrEqual, fm:EqualTo))

    # The document the exchange actually read, and the fact something superseded it.
    ?settlement fm:hasOutput ?resolution ;
                fm:hasInput  ?settledDocument .
    ?currentDocument wx:supersedes+ ?settledDocument .
    FILTER NOT EXISTS { ?newer wx:supersedes ?currentDocument }

    # What that document now says the value was.
    ?currentDocument bfo:BFO_0000178 ?datum .
    ?datum wx:reportsValueFor ?target ;
           fm:realizedValue ?currentValue .

    # Re-evaluate the proposition's own condition against it.
    BIND(
        IF(?comparator = fm:Between,            ?currentValue >= ?floor && ?currentValue <= ?cap,
        IF(?comparator = fm:LessThanOrEqual,    ?currentValue <= ?cap,
        IF(?comparator = fm:LessThan,           ?currentValue <  ?cap,
        IF(?comparator = fm:GreaterThanOrEqual, ?currentValue >= ?floor,
        IF(?comparator = fm:GreaterThan,        ?currentValue >  ?floor,
                                                 ?currentValue =  ?floor)))))
        AS ?holdsNow)

    BIND(IF(?holdsNow, ksh:ResolvedYes, ksh:ResolvedNo) AS ?impliedOutcome)
    BIND(IF(?impliedOutcome = ?settledOutcome, "consistent", "CONTRADICTED") AS ?verdict)

    # Cross-check against the stored assessment for the same document.
    OPTIONAL {
        ?assessment fm:assessesProposition ?proposition ;
                    fm:basedOnRecord ?currentDocument ;
                    fm:assessedTruthValue ?recordedAssessment .
    }
}
ORDER BY ?ticker
