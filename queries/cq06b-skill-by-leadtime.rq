# CQ6b. Aggregate forecast skill by model and lead time.
#
# The companion to cq06a. That query bins by forecast probability, which is the
# classic reliability presentation but spreads a 40-day sample across five bins
# and leaves individual rows dominated by noise. This one aggregates over bins,
# so each cell rests on every assignment that model made at that lead time, and
# is the number to quote at this sample size.
#
# ?meanBrier is the headline: mean squared error of the probability assignments,
# lower is better. Two things should fall out of it, and both are checks on the
# machinery as much as on the models:
#
#   * Skill degrades with lead time. A 72-hour forecast should score worse than
#     a 24-hour one. If it does not, lead time is not being recorded correctly.
#   * The overconfident model scores worse than the calibrated one at both leads,
#     despite the two seeing exactly the same underlying signal. That difference
#     is purely the cost of overstating confidence.
#
# ?baseRate is how often the propositions were actually true. ?climatologyBrier is
# what a forecaster who ignored the weather and always predicted that base rate
# would score. Beating it is the minimum bar for a model being worth running.
#
# ?meanAbsError is mean |p - o|, and it is here as a WARNING, not as a second
# opinion. It is not a proper scoring rule: it rewards stating extreme
# probabilities regardless of whether they are warranted. In the checked-in result
# the overconfident model scores BETTER on it than the calibrated one (0.234 vs
# 0.245 at 24h) while scoring worse on every honest measure. That inversion is the
# whole argument for using Brier, and it is why absolute error should not be used
# to rank forecasters even though it is the intuitive first choice.
#
# Negative lead times appear as their own rows, unpooled. See cq06a.
#
# GROUPING INCLUDES THE VARIABLE. A model that forecasts more than one variable --
# ex:GEFS carries both a temperature and a precipitation assignment -- gets a row per
# variable rather than one row averaging a Brier score in degrees with one in inches.
# Grouping by model and lead time alone happened to keep those two apart only because
# their lead times differed; a third forecast could have collided with either.
# Read skill degradation DOWN a variable's rows, never across two variables' rows.

SELECT ?model ?variable ?leadHours ?n ?sourceRows ?meanForecast ?baseRate ?meanBrier ?climatologyBrier ?meanAbsError
WHERE {
    {
        SELECT ?model ?leadHours ?variable
               (COUNT(*)   AS ?n)
               (SUM(?rows) AS ?sourceRows)
               (ROUND(AVG(?p)      * 1000) / 1000 AS ?meanForecast)
               (ROUND(AVG(?o)      * 1000) / 1000 AS ?baseRate)
               (ROUND(AVG(?sq)     * 1000) / 1000 AS ?meanBrier)
               (ROUND(AVG(?absErr) * 1000) / 1000 AS ?meanAbsError)
        WHERE {
            {
                SELECT ?model ?leadHours ?variable ?fp
                       (MAX(?pv) AS ?p) (MAX(?ov) AS ?o) (COUNT(*) AS ?rows)
                WHERE {
                    ?forecast a/rdfs:subClassOf* wx:ProbabilisticForecast ;
                              wx:producedByModel ?model ;
                              wx:leadTimeHours   ?leadHours ;
                              bfo:BFO_0000178    ?fp .

                    ?fp a/rdfs:subClassOf* fm:ForecastProbability ;
                        fm:assignsProbabilityTo ?proposition ;
                        fm:probabilityValue ?pv .

                    # Grouping keys include the variable: without it a temperature
                    # and a precipitation assignment at the same model and lead time
                    # merge into one row, averaging a Brier score in degrees with one
                    # in inches. Every forecast probability reaches a target variable,
                    # so this drops nothing.
                    ?proposition fm:hasSubject ?target .
                    ?target wx:targetVariable ?variable .

                    # Only the assessment resting on a record nothing supersedes.
                    ?assessment fm:assessesProposition ?proposition ;
                                fm:basedOnRecord ?record ;
                                fm:assessedTruthValue ?tv .
                    FILTER NOT EXISTS { ?newer wx:supersedes ?record }

                    # fm:Indeterminate is a legal truth value and is not an
                    # observed "no"; scoring it as 0 would silently count it.
                    FILTER(?tv IN (fm:True, fm:False))
                    BIND(IF(?tv = fm:True, 1, 0) AS ?ov)
                }
                GROUP BY ?model ?leadHours ?variable ?fp
            }

            BIND((?p - ?o) * (?p - ?o) AS ?sq)
            BIND(IF(?p > ?o, ?p - ?o, ?o - ?p) AS ?absErr)
        }
        GROUP BY ?model ?leadHours ?variable
    }
    BIND(ROUND(?baseRate * (1 - ?baseRate) * 1000) / 1000 AS ?climatologyBrier)
}
ORDER BY ?model ?variable ?leadHours
