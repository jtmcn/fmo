# A correction issued after settlement, contradicting two settled markets.
#
# This is the case CQ7 exists for, and it is not hypothetical: daily climate
# records are reissued when a sensor fault or a transcription error is found,
# sometimes days later. Since 2026-08-14 the settlement source is The Weather
# Company rather than the NWS directly, so the correction that reaches the market
# is TWC's own reissue -- which is why both the record read at settlement and the
# correction superseding it are TWC records here. The NWS record in the base
# example is deliberately NOT corrected alongside it: it is a separate
# determination under a separate protocol, and disagreeing is its job.
# Exchanges generally do not re-settle. So the observational record and the
# exchange's payout permanently disagree, and both are correct about what they
# record.
#
# Timeline:
#   2026-08-16 10:15Z  The TWC record reports the 15 Aug high as 82.
#   2026-08-16 14:30Z  Kalshi settles the ladder on 82. B82.5 pays yes.
#   2026-08-17 09:05Z  TWC reissues its record. The high was 84.
#
# Against the corrected record:
#   Prop-LE81   (<= 81)   84 fails  -> resolved no   -> consistent
#   Prop-82-83  ([82,83]) 84 fails  -> resolved YES  -> CONTRADICTED
#   Prop-84-85  ([84,85]) 84 holds  -> resolved NO   -> CONTRADICTED
#   Prop-GE86   (>= 86)   84 fails  -> resolved no   -> consistent
#
# Both directions of error appear, which is what makes this useful test data: a
# query that only caught false-positives would still pass on half of it.
#
# NOTE ON WHAT IS NOT ASSERTED. No fm:hasTruthValue appears anywhere in these
# examples. It is functional and untimed, so asserting a settlement-era value and
# a post-correction value would force fm:True and fm:False to be one individual
# -- and thanks to the owl:AllDifferent block in core.ttl, that is now a reasoner
# inconsistency rather than a silent wrong answer. Truth lives in
# fm:TruthAssessment, which carries the record it read and when.

@prefix ex:   <https://w3id.org/forecast-market-ontology/examples/kxhighny-2026-08-15#> .
@prefix fm:   <https://w3id.org/forecast-market-ontology/core#> .
@prefix wx:   <https://w3id.org/forecast-market-ontology/weather#> .
@prefix ksh:  <https://w3id.org/forecast-market-ontology/kalshi#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<https://w3id.org/forecast-market-ontology/examples/kxhighny-2026-08-15-correction>
    a owl:Ontology ;
    owl:imports <https://w3id.org/forecast-market-ontology/examples/kxhighny-2026-08-15-bracketset> ;
    rdfs:label "Worked example: a post-settlement correction to the CLINYC record" .

################################################################
# The corrected report
################################################################

ex:TWCRecord-2026-08-17-COR a wx:ReportCorrection ;
    rdfs:label "The Weather Company CLINYC record corrected, issued 2026-08-17" ;
    fm:issuedBy ex:TWC ;
    fm:overTemporalInterval ex:ClimDay-2026-08-15 ;
    wx:issuanceTime "2026-08-17T09:05:00Z"^^xsd:dateTime ;
    wx:supersedes ex:TWCRecord-2026-08-16 ;
    fm:statedAs "Corrected. The maximum temperature for 15 August 2026 was 84, not 82. The original value was affected by a transcription error in this record." ;
    bfo:BFO_0000178 ex:Datum-Max-Corrected .    # has continuant part

ex:Datum-Max-Corrected a wx:WeatherObservationDatum ;
    rdfs:label "corrected max temperature, 84 F" ;
    wx:reportsValueFor ex:Target-HighTemp ;
    fm:realizedValue "84"^^xsd:decimal ;
    fm:hasUnit unit:DEG_F .

################################################################
# Reassessment against the corrected record.
#
# The propositions are unchanged and the exchange's resolutions are unchanged.
# Only the assessments are new, because only the record changed.
################################################################

ex:Reassessment-82-83 a fm:TruthAssessment ;
    rdfs:label "reassessment of Prop-82-83 after correction" ;
    fm:assessesProposition ex:Prop-82-83 ;
    fm:assessedTruthValue fm:False ;
    fm:basedOnRecord ex:TWCRecord-2026-08-17-COR ;
    fm:referenceTime "2026-08-17T09:05:00Z"^^xsd:dateTime ;
    fm:statedAs "84 is not within [82, 83]. The market nonetheless paid out yes." .

ex:Reassessment-84-85 a fm:TruthAssessment ;
    rdfs:label "reassessment of Prop-84-85 after correction" ;
    fm:assessesProposition ex:Prop-84-85 ;
    fm:assessedTruthValue fm:True ;
    fm:basedOnRecord ex:TWCRecord-2026-08-17-COR ;
    fm:referenceTime "2026-08-17T09:05:00Z"^^xsd:dateTime ;
    fm:statedAs "84 is within [84, 85]. The market nonetheless paid out no." .

ex:Reassessment-LE81 a fm:TruthAssessment ;
    rdfs:label "reassessment of Prop-LE81 after correction" ;
    fm:assessesProposition ex:Prop-LE81 ;
    fm:assessedTruthValue fm:False ;
    fm:basedOnRecord ex:TWCRecord-2026-08-17-COR ;
    fm:referenceTime "2026-08-17T09:05:00Z"^^xsd:dateTime .

ex:Reassessment-GE86 a fm:TruthAssessment ;
    rdfs:label "reassessment of Prop-GE86 after correction" ;
    fm:assessesProposition ex:Prop-GE86 ;
    fm:assessedTruthValue fm:False ;
    fm:basedOnRecord ex:TWCRecord-2026-08-17-COR ;
    fm:referenceTime "2026-08-17T09:05:00Z"^^xsd:dateTime .

# The evaluation process that produced the reassessments. Not a market
# settlement: nobody was paid, and the exchange was not involved.
ex:Reassessment-Process a fm:EvaluationProcess ;
    rdfs:label "reassessment of the KXHIGHNY-26AUG15 ladder against the corrected record" ;
    fm:hasInput ex:TWCRecord-2026-08-17-COR ;
    fm:hasOutput ex:Reassessment-82-83 , ex:Reassessment-84-85 ,
                  ex:Reassessment-LE81 , ex:Reassessment-GE86 .

################################################################
# Scoring the forecast, against the record that is now authoritative.
#
# The GEFS 06Z run gave the 82-83 bracket 0.52. The corrected record makes the
# proposition false, so the Brier score is (0.52 - 0)^2 = 0.2704. Scored against
# ex:Reassessment-82-83 and not the settlement-era assessment: the market paid
# out yes, and scoring the forecast against what the exchange did rather than
# what the record now says would measure the wrong thing.
#
# fm:scoredAgainst is what makes that choice inspectable after the fact. Without
# it the score is a number whose provenance is a matter of trust.
################################################################

ex:Verification-82-83 a wx:ForecastVerification ;
    rdfs:label "verification of the GEFS 06Z P(82-83F) against the corrected record" ;
    fm:hasInput ex:ForecastProb-82-83 , ex:Reassessment-82-83 ;
    fm:hasOutput ex:Score-82-83 .

ex:Score-82-83 a fm:SkillScore ;
    rdfs:label "Brier score for the GEFS 06Z P(82-83F)" ;
    fm:scoresAssignment ex:ForecastProb-82-83 ;
    fm:usesScoringRule fm:BrierScore ;
    fm:scoredAgainst ex:Reassessment-82-83 ;
    fm:scoreValue "0.2704"^^xsd:decimal ;
    fm:statedAs "(0.52 - 0)^2 = 0.2704. The proposition is false on the corrected record, though the market paid out yes." .
