# Worked example: one Kalshi temperature bracket market and one ensemble forecast,
# both attached to the SAME proposition, followed through to settlement.
#
# The point of the example is the join. ex:Prop-82-83 appears as the object of
# ksh:expressesProposition (from the market) and as the object of
# fm:assignsProbabilityTo (from both the forecast probability and the market
# implied probability). Nothing else has to line up for the two beliefs to be
# comparable: not tickers, not station names, not dates.
#
# Values are illustrative and are not real observations or quotes.

@prefix ex:   <https://w3id.org/forecast-market-ontology/examples/kxhighny-2026-08-15#> .
@prefix fm:   <https://w3id.org/forecast-market-ontology/core#> .
@prefix wx:   <https://w3id.org/forecast-market-ontology/weather#> .
@prefix ksh:  <https://w3id.org/forecast-market-ontology/kalshi#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .

<https://w3id.org/forecast-market-ontology/examples/kxhighny-2026-08-15>
    a owl:Ontology ;
    owl:imports <https://w3id.org/forecast-market-ontology/fmo> ;
    rdfs:label "Worked example: KXHIGHNY-26AUG15" .

################################################################
# 1. Place and instrument
################################################################

ex:CentralParkSite a wx:ObservingSite ;
    rdfs:label "Central Park observing site" ;
    wx:stationOfRecord ex:KNYC .

ex:KNYC a wx:WeatherStation ;
    rdfs:label "ASOS KNYC, Central Park" ;
    wx:stationIdentifier "KNYC" ;
    bfo:BFO_0000171 ex:CentralParkSite .    # located in

ex:NWS a fm:Organization ;
    rdfs:label "National Weather Service" .

# Kalshi moved daily temperature settlement from the NWS to The Weather Company
# on 2026-08-14, the day before this example. TWC states that it uses NWS as its
# primary underlying source, so the numbers usually agree -- but the authority
# that settles the market is TWC, and under the protocol rule that is what fixes
# the observation target. NWS remains here as the issuer of GEFS.
ex:TWC a fm:Organization ;
    rdfs:label "The Weather Company" .

################################################################
# 2. Time
#
# The NWS climatological day runs local STANDARD time midnight to midnight all
# year. 15 August 2026 is inside daylight saving time, so the interval runs from
# 01:00 EDT on the 15th to 00:59:59 EDT on the 16th. Writing the instants out
# makes the boundary auditable instead of leaving it implied by a date string.
################################################################

ex:ClimDay-2026-08-15 a wx:ClimatologicalDay ;
    rdfs:label "climatological day 2026-08-15 at Central Park" ;
    bfo:BFO_0000222 ex:Instant-Start ;      # has first instant
    bfo:BFO_0000224 ex:Instant-End .        # has last instant

ex:Instant-Start a bfo:BFO_0000203 ; fm:instantDateTime "2026-08-15T01:00:00-04:00"^^xsd:dateTime .
ex:Instant-End   a bfo:BFO_0000203 ; fm:instantDateTime "2026-08-16T00:59:59-04:00"^^xsd:dateTime .

################################################################
# 3. What is being measured
################################################################

ex:TWCDailyTempProtocol a wx:MeasurementProtocol ;
    rdfs:label "The Weather Company daily temperature protocol for CLINYC" ;
    fm:statedAs "Maximum temperature for the New York City station of record, identified as CLINYC, over the climatological day, in whole degrees Fahrenheit, as published by The Weather Company at weather.com/kalshi." ;
    fm:issuedBy ex:TWC .

ex:Target-HighTemp a wx:WeatherObservationTarget ;
    rdfs:label "max air temperature, Central Park, climatological day 2026-08-15" ;
    wx:targetVariable wx:MaximumAirTemperature ;
    wx:atSite ex:CentralParkSite ;
    fm:overTemporalInterval ex:ClimDay-2026-08-15 ;
    wx:underProtocol ex:TWCDailyTempProtocol ;
    fm:hasUnit unit:DEG_F .

################################################################
# 4. The proposition -- the pivot
################################################################

ex:Prop-82-83 a fm:Proposition ;
    rdfs:label "high is between 82 and 83 degrees F" ;
    fm:hasSubject ex:Target-HighTemp ;
    fm:hasComparator fm:Between ;
    fm:floorValue "82"^^xsd:decimal ;
    fm:capValue "83"^^xsd:decimal ;
    fm:hasUnit unit:DEG_F ;
    fm:statedAs "The maximum air temperature at the Central Park station of record over the climatological day of 15 August 2026, as published by The Weather Company, is between 82 and 83 degrees Fahrenheit inclusive." .

################################################################
# 5. The market side
################################################################

ex:TWCSettlementSource a ksh:SettlementSource ;
    rdfs:label "The Weather Company daily temperature record for CLINYC" ;
    ksh:sourceProtocol ex:TWCDailyTempProtocol ;
    fm:issuedBy ex:TWC .

ex:KXHIGHNY a ksh:Series ;
    rdfs:label "Kalshi: highest temperature in NYC" ;
    ksh:seriesTicker "KXHIGHNY" ;
    ksh:settlementSource ex:TWCSettlementSource ;
    fm:issuedBy ksh:Kalshi .

ex:KXHIGHNY-26AUG15 a ksh:EventGrouping ;
    rdfs:label "Kalshi: NYC high on 2026-08-15" ;
    ksh:eventTicker "KXHIGHNY-26AUG15" ;
    ksh:inSeries ex:KXHIGHNY ;
    ksh:coversTarget ex:Target-HighTemp ;
    ksh:mutuallyExclusive true .

ex:Market-B82 a ksh:WeatherMarket ;
    rdfs:label "KXHIGHNY-26AUG15-B82.5" ;
    ksh:marketTicker "KXHIGHNY-26AUG15-B82.5" ;
    ksh:inEventGrouping ex:KXHIGHNY-26AUG15 ;
    ksh:expressesProposition ex:Prop-82-83 ;
    ksh:hasStatus ksh:Finalized ;
    ksh:closeTime "2026-08-16T04:59:59Z"^^xsd:dateTime ;
    ksh:expectedExpirationTime "2026-08-16T11:00:00Z"^^xsd:dateTime ;
    ksh:latestExpirationTime   "2026-08-22T14:40:18Z"^^xsd:dateTime .

ex:Quote-1200Z a ksh:Quote ;
    rdfs:label "quote for KXHIGHNY-26AUG15-B82.5 at 12:00Z" ;
    ksh:quoteForMarket ex:Market-B82 ;
    fm:referenceTime "2026-08-15T12:00:00Z"^^xsd:dateTime ;
    ksh:yesBidCents 58 ;
    ksh:yesAskCents 62 ;
    ksh:lastPriceCents 60 ;
    ksh:volume 14350 ;
    ksh:openInterest 8210 .

ex:MarketProb-1200Z a fm:MarketImpliedProbability ;
    rdfs:label "market implied P(82-83F) at 12:00Z" ;
    fm:assignsProbabilityTo ex:Prop-82-83 ;
    fm:probabilityValue "0.60"^^xsd:decimal ;
    fm:referenceTime "2026-08-15T12:00:00Z"^^xsd:dateTime ;
    ksh:derivedFromQuote ex:Quote-1200Z ;
    fm:statedAs "Last traded price of 60 cents divided by 100. Ignores spread, fees, and carry." .

ex:Derivation-1200Z a ksh:PriceToProbabilityDerivation ;
    fm:hasInput ex:Quote-1200Z ;
    fm:hasOutput ex:MarketProb-1200Z .

################################################################
# 6. The forecast side -- same proposition, different agent, different process
################################################################

ex:GEFS a wx:NumericalWeatherPredictionModel ;
    rdfs:label "Global Ensemble Forecast System" ;
    fm:issuedBy ex:NWS .

ex:GEFS-Run-2026-08-15T06Z a wx:ModelRun ;
    rdfs:label "GEFS 06Z run, 2026-08-15" ;
    wx:cycleTime "2026-08-15T06:00:00Z"^^xsd:dateTime ;
    fm:hasAgent ex:NWS ;
    fm:hasOutput ex:Forecast-GEFS-06Z .

ex:Forecast-GEFS-06Z a wx:ProbabilisticForecast ;
    rdfs:label "GEFS 06Z probabilistic forecast for Central Park high, 2026-08-15" ;
    wx:forecastFor ex:Target-HighTemp ;
    wx:producedByModel ex:GEFS ;
    wx:issuanceTime "2026-08-15T09:40:00Z"^^xsd:dateTime ;
    # Negative: issued 09:40Z, but the climatological day began at 05:00Z. A
    # same-day update to a daily maximum, which is routine. Recorded rather than
    # omitted so CQ6 shows it as its own row instead of silently dropping it.
    wx:leadTimeHours "-4.667"^^xsd:decimal ;
    bfo:BFO_0000178 ex:ForecastProb-82-83 .     # has continuant part

ex:ForecastProb-82-83 a fm:ForecastProbability ;
    rdfs:label "GEFS 06Z P(82-83F)" ;
    fm:assignsProbabilityTo ex:Prop-82-83 ;
    fm:probabilityValue "0.52"^^xsd:decimal ;
    fm:referenceTime "2026-08-15T06:00:00Z"^^xsd:dateTime .

# The 8-point gap between ex:ForecastProb-82-83 and ex:MarketProb-1200Z is the
# quantity this ontology exists to make well-formed. Both are probability
# assignments over the identical proposition, so subtracting them is meaningful.

################################################################
# 7. What actually happened, and settlement
################################################################

ex:Observation-Max a wx:WeatherObservation ;
    rdfs:label "determination of the daily max at KNYC" ;
    bfo:BFO_0000057 ex:KNYC ;                   # has participant
    bfo:BFO_0000199 ex:ClimDay-2026-08-15 ;     # occupies temporal region
    fm:hasOutput ex:Datum-Max .

ex:Datum-Max a wx:WeatherObservationDatum ;
    rdfs:label "max temperature 82 F" ;
    wx:reportsValueFor ex:Target-HighTemp ;
    fm:realizedValue "82"^^xsd:decimal ;
    fm:hasUnit unit:DEG_F .

ex:TWCRecord-2026-08-16 a wx:DailyClimatologicalReport ;
    rdfs:label "The Weather Company CLINYC record, issued 2026-08-16" ;
    fm:issuedBy ex:TWC ;
    fm:overTemporalInterval ex:ClimDay-2026-08-15 ;
    wx:issuanceTime "2026-08-16T10:15:00Z"^^xsd:dateTime ;
    bfo:BFO_0000178 ex:Datum-Max .              # has continuant part

################################################################
# 7b. The authority the exchange did NOT settle on
#
# The NWS still publishes CLINYC, and a forecast scored against it is answering
# a different question from the one the market settles. Same variable, same
# site, same climatological day, different protocol -- so a different target,
# and here it also reports a different number. 83, not 82, which would have
# resolved a different bracket had the exchange read it.
#
# wx:alternativeDeterminationOf records that the two are meant to capture the
# same physical quantity. It licenses nothing: no query may substitute one for
# the other, and the divergence below is exactly why.
################################################################

ex:NWSDailyClimateProtocol a wx:MeasurementProtocol ;
    rdfs:label "NWS daily climatological summary protocol" ;
    fm:statedAs "Maximum temperature observed at the station of record over the climatological day, in whole degrees Fahrenheit, as published in the CLI product." ;
    fm:issuedBy ex:NWS .

ex:Target-HighTemp-NWS a wx:WeatherObservationTarget ;
    rdfs:label "max air temperature, Central Park, climatological day 2026-08-15, NWS protocol" ;
    wx:targetVariable wx:MaximumAirTemperature ;
    wx:atSite ex:CentralParkSite ;
    fm:overTemporalInterval ex:ClimDay-2026-08-15 ;
    wx:underProtocol ex:NWSDailyClimateProtocol ;
    fm:hasUnit unit:DEG_F ;
    wx:alternativeDeterminationOf ex:Target-HighTemp .

ex:CLINYC-2026-08-16 a wx:DailyClimatologicalReport ;
    rdfs:label "NWS CLINYC issued 2026-08-16" ;
    fm:issuedBy ex:NWS ;
    fm:overTemporalInterval ex:ClimDay-2026-08-15 ;
    wx:issuanceTime "2026-08-16T10:15:00Z"^^xsd:dateTime ;
    bfo:BFO_0000178 ex:Datum-Max-NWS .          # has continuant part

ex:Datum-Max-NWS a wx:WeatherObservationDatum ;
    rdfs:label "max temperature 83 F, NWS" ;
    wx:reportsValueFor ex:Target-HighTemp-NWS ;
    fm:realizedValue "83"^^xsd:decimal ;
    fm:hasUnit unit:DEG_F .

# Nothing settles on ex:Target-HighTemp-NWS and nothing forecasts for it. It is
# here to be disagreed with, and to give the validator a misalignment to detect
# if a future forecast is ever pointed at it while the market settles on the other.

# The same bracket read against the authority the exchange did NOT settle on.
# Nothing points at it; it exists so the grouping-agreement check has a target to
# catch a market drifting onto, the way Target-HighTemp-NWS does for forecasts.
ex:Prop-82-83-NWS a fm:Proposition ;
    rdfs:label "high is between 82 and 83 degrees F, NWS determination" ;
    fm:hasSubject ex:Target-HighTemp-NWS ;
    fm:hasComparator fm:Between ;
    fm:floorValue "82"^^xsd:decimal ;
    fm:capValue "83"^^xsd:decimal ;
    fm:hasUnit unit:DEG_F .

ex:Settlement-B82 a ksh:MarketSettlement ;
    rdfs:label "settlement of KXHIGHNY-26AUG15-B82.5" ;
    fm:hasAgent ksh:Kalshi ;
    fm:hasInput ex:TWCRecord-2026-08-16 ;
    fm:hasOutput ex:Resolution-B82 .

ex:Resolution-B82 a ksh:Resolution ;
    rdfs:label "KXHIGHNY-26AUG15-B82.5 resolved yes" ;
    ksh:resolutionOf ex:Market-B82 ;
    ksh:resolvesTo ksh:ResolvedYes ;
    ksh:settlementValue "82"^^xsd:decimal ;
    fm:hasUnit unit:DEG_F .

# Settlement is what assigns the truth value. Before this, the proposition had
# none -- which is not the same as being false.
#
# Recorded as a fm:TruthAssessment rather than fm:hasTruthValue because the
# document it rests on can be superseded. See examples/...-correction.ttl, where
# exactly that happens and this assessment stops being the current one.
ex:Assessment-82-83-at-settlement a fm:TruthAssessment ;
    rdfs:label "assessment of Prop-82-83 at settlement" ;
    fm:assessesProposition ex:Prop-82-83 ;
    fm:assessedTruthValue fm:True ;
    fm:basedOnRecord ex:TWCRecord-2026-08-16 ;
    fm:referenceTime "2026-08-16T14:30:00Z"^^xsd:dateTime .
